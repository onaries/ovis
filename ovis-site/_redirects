# The one-line installers and the browser demo are built with the app into GitHub Pages
# (site/, herdrweb.dev); ovis.sh hands them on, so every link can name ovis.sh.
/install.sh https://herdrweb.dev/install.sh 302
/install.ps1 https://herdrweb.dev/install.ps1 302
/demo https://herdrweb.dev/demo/ 302
/demo/* https://herdrweb.dev/demo/:splat 302
# Ovis for Mac: the newest release's signed Ovis.dmg (.github/workflows/mac-dmg.yml attaches it).
/Ovis.dmg https://github.com/devswha/ovis/releases/latest/download/Ovis.dmg 302
# Ovis for Windows: the newest release's Ovis.exe (.github/workflows/windows-app.yml attaches it).
/Ovis.exe https://github.com/devswha/ovis/releases/latest/download/Ovis.exe 302
# Addresses people guess for the docs, which live in the repository.
/docs https://github.com/devswha/ovis/blob/main/docs/guide.md 302
/docs/* https://github.com/devswha/ovis/blob/main/docs/guide.md 302
/guide https://github.com/devswha/ovis/blob/main/docs/guide.md 302
/guide/* https://github.com/devswha/ovis/blob/main/docs/guide.md 302
/install https://github.com/devswha/ovis/blob/main/README.md#install 302
/changelog https://github.com/devswha/ovis/blob/main/CHANGELOG.md 302
/faq /#faq 302
# The home page reads in Japanese and Chinese through ?lang=, like /ko/.
/ja /?lang=ja 302
/ja/* /?lang=ja 302
/zh /?lang=zh 302
/zh/* /?lang=zh 302
