<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package. build.ps1 fills in the $...$ values; the identity comes from Partner Center
     (README.md, "Microsoft Store"). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop rescap">
  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>Ovis</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ko-kr" />
  </Resources>
  <Applications>
    <Application Id="Ovis" Executable="Ovis.exe" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="Ovis" Description="Set up Ovis on this PC: herdr, Bun and the Ovis server, and the QR code for the phone app."
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="transparent" />
    </Application>
    <!-- herdr's server at sign-in. Windows turns the task on the first time Ovis is opened, and the user can turn it
         off in Settings > Apps > Startup. Run this way, Ovis.exe opens no window and starts herdr only when the Ovis
         server is installed and herdr is not running. -->
    <Application Id="OvisStart" Executable="Ovis.exe" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL" uap10:Parameters="--start">
      <uap:VisualElements DisplayName="Ovis" Description="Starts herdr when you sign in." AppListEntry="none"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="transparent" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="OvisHerdrServer" Enabled="true" DisplayName="Ovis (herdr)" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
